# SynapsePlane — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git. It is in .gitignore.

# ────────────────────────────────────────────────
# Database
# ────────────────────────────────────────────────
# PostgreSQL (used by Docker Compose)
DATABASE_URL=postgresql+asyncpg://synapse:synapse@localhost:5432/synapse_plane

# SQLite alternative (for lightweight local dev without Docker)
# DATABASE_URL=sqlite+aiosqlite:///./synapse_plane_dev.db

# ────────────────────────────────────────────────
# LLM Provider
# ────────────────────────────────────────────────
# API key — leave blank to use the deterministic fake planner/extractor.
# This project points OPENAI_API_KEY/OPENAI_MODEL at Gemini's OpenAI-compatible
# endpoint (see src/synapse_plane/llm/gemini_client.py) rather than adding a
# separate GEMINI_API_KEY — the field names are historical, the value isn't.
OPENAI_API_KEY=

# e.g. gemini-3.5-flash-lite — check `client.models.list()` against the
# OpenAI-compat endpoint before assuming a model name still exists, but note
# that list() can still show a model your API key isn't actually entitled to
# call (confirmed: gemini-2.5-flash-lite listed fine, then 404'd on an actual
# generateContent call with "no longer available to new users" — the error
# message itself named the correct replacement). Trust a real generateContent
# call over the list, and re-verify if you change this.
OPENAI_MODEL=gpt-4o-mini

# Which model to use for memory embeddings (Step 2b hybrid retrieval)
EMBEDDING_MODEL=text-embedding-3-small

# Tavily search API key — used by the Open Deep Research and (Tavily-backed)
# Browser Use adapters. Leave blank to keep those adapters unconfigured.
TAVILY_API_KEY=

# ────────────────────────────────────────────────
# Google Calendar (P1 — optional)
# ────────────────────────────────────────────────
# Desktop-app OAuth flow (not a web redirect flow): download an "installed
# app" OAuth client from Google Cloud Console (Calendar API enabled), save it
# as credentials.json in the project root, then run once, interactively:
#   python scripts/setup_google_calendar_auth.py
# This opens a browser for consent and caches token.json — required before
# CALENDAR_PROVIDER=google will work. Set CALENDAR_PROVIDER=mock to skip.
GOOGLE_CALENDAR_CREDENTIALS_PATH=credentials.json
GOOGLE_CALENDAR_TOKEN_PATH=token.json

# ────────────────────────────────────────────────
# Application settings
# ────────────────────────────────────────────────
# Secret key for signing tokens (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-in-production-generate-a-real-secret

# App environment: development | production
APP_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ────────────────────────────────────────────────
# Demo / development controls
# ────────────────────────────────────────────────
# Set to true to show scenario selector controls in the UI
DEMO_MODE=true

# Which calendar provider to use: mock | google
CALENDAR_PROVIDER=mock

# Which places provider to use: mock | google_places | yelp
PLACES_PROVIDER=mock

# ────────────────────────────────────────────────
# CORS (for local frontend dev)
# ────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
