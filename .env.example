# SynapsePlane — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git. It is in .gitignore.

# ────────────────────────────────────────────────
# Database
# ────────────────────────────────────────────────
# PostgreSQL (used by Docker Compose)
DATABASE_URL=postgresql+asyncpg://synapse:synapse@localhost:5432/synapse_plane

# SQLite alternative (for lightweight local dev without Docker)
# DATABASE_URL=sqlite+aiosqlite:///./synapse_plane_dev.db

# ────────────────────────────────────────────────
# LLM Provider
# ────────────────────────────────────────────────
# OpenAI API key — leave blank to use the deterministic fake planner
OPENAI_API_KEY=

# Which model to use for the intent planner
OPENAI_MODEL=gpt-4o-mini

# Which model to use for memory embeddings (Step 2b hybrid retrieval)
EMBEDDING_MODEL=text-embedding-3-small

# ────────────────────────────────────────────────
# Google Calendar (P1 — optional)
# ────────────────────────────────────────────────
# Set up a Google Cloud project with Calendar API enabled.
# Create an OAuth 2.0 client. Add the callback URL below.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ────────────────────────────────────────────────
# Application settings
# ────────────────────────────────────────────────
# Secret key for signing tokens (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-in-production-generate-a-real-secret

# App environment: development | production
APP_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ────────────────────────────────────────────────
# Demo / development controls
# ────────────────────────────────────────────────
# Set to true to show scenario selector controls in the UI
DEMO_MODE=true

# Which calendar provider to use: mock | google
CALENDAR_PROVIDER=mock

# Which places provider to use: mock | google_places | yelp
PLACES_PROVIDER=mock

# ────────────────────────────────────────────────
# CORS (for local frontend dev)
# ────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
